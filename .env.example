# Neon Postgres connection string (Vercel > Storage > Neon, or console.neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Signs admin sessions, and is the password for the FIRST sign-in only
# (after that, change it in Settings). Use a long random string.
# Rotating this value signs everyone out.
ADMIN_KEY="change-me"
